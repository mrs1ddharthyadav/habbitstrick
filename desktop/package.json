{
  "name": "habbit-strick",
  "productName": "Habbit Strick",
  "version": "1.0.0",
  "description": "Habbit Strick, a private habit and task tracker for Windows",
  "author": "Sangam Yadav",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.habbitstrick.desktop",
    "productName": "Habbit Strick",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.png", "app/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "Habbit-Strick-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      { "provider": "generic", "url": "https://github.com/mrs1ddharthyadav/habbitstrick/releases/download/latest" }
    ]
  }
}
